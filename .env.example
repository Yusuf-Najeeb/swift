# ──────────────────────────────────────────────────────────
# Swift Writer — environment configuration
# Copy this file to `.env` and fill in the values.
# ──────────────────────────────────────────────────────────

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: override the OpenRouter endpoint (rarely needed)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Serper API key (https://serper.dev) — free tier: 2,500
# queries. When set, the Evaluator's google_search + scrape tools
# activate automatically so it can fact-check claims the Writer
# didn't cite with a URL. Leave blank to disable.
SERPER_API_KEY=

# ─── Model overrides (OpenRouter model slugs) ─────────────
# Defaults are baked into backend/config.py; uncomment to override.
# SWIFT_ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4.5
# SWIFT_WRITER_MODEL=openai/gpt-4o-mini
# SWIFT_EVALUATOR_MODEL=openai/gpt-4o
# SWIFT_IMAGE_AGENT_MODEL=openai/gpt-4o-mini

# ─── Storage ──────────────────────────────────────────────
# SWIFT_ARTICLES_DIR=articles

# ─── CORS ─────────────────────────────────────────────────
# Comma separated list of allowed origins for the frontend.
# SWIFT_CORS_ORIGINS=http://localhost:3000

# ─── Writer MCP consumers ─────────────────────────────────
# The Writer agent can be attached to external MCP servers so it can
# fetch URLs, run web searches, etc. By default the reference
# `mcp-server-fetch` (URL reader, no API key) is enabled and launched
# via `uvx`. Set to 0 to disable.
# SWIFT_WRITER_MCP_FETCH_ENABLED=1
#
# First-time / dev speed: each enabled ``uvx mcp-server-fetch`` process may
# spend minutes on a cold cache ("Resolving dependencies…" in the server
# terminal). To iterate on the UI without MCP tools, set these to 0:
# SWIFT_WRITER_MCP_FETCH_ENABLED=0
# SWIFT_EVALUATOR_MCP_FETCH_ENABLED=0
# SWIFT_EVALUATOR_MCP_SERPER_ENABLED=0
#
# Pre-warm the fetch tool once (then runs start quickly):
#   UV_NO_PROGRESS=1 uvx mcp-server-fetch </dev/null
#
# Extra MCP servers as a JSON list of MCPServerSpec objects. Examples:
#
#   stdio (local subprocess):
#     {"name":"search","transport":"stdio","command":"uvx",
#      "args":["some-mcp-search-server"],"env":{"API_KEY":"..."}}
#
#   streamable http (remote):
#     {"name":"tavily","transport":"http",
#      "url":"https://mcp.tavily.com/","headers":{"Authorization":"Bearer ..."}}
#
# SWIFT_WRITER_MCP_SERVERS=[]

# ─── Evaluator MCP consumers ──────────────────────────────
# The Evaluator agent fact-checks the Writer's draft. By default it's
# attached to:
#   1. `mcp-server-fetch` — reads any URL the Writer cited inline.
#   2. `serper-search-scrape-mcp-server` — Google search + page
#      scrape. Activates automatically iff SERPER_API_KEY is set
#      above.
#
# Disable either independently (set to 0):
# SWIFT_EVALUATOR_MCP_FETCH_ENABLED=1
# SWIFT_EVALUATOR_MCP_SERPER_ENABLED=1
#
# Extra MCP servers (Tavily, Brave, private knowledge bases, …) as a
# JSON list of MCPServerSpec objects. Examples:
#
#   Tavily search (needs TAVILY_API_KEY):
#     {"name":"tavily","transport":"stdio","command":"npx",
#      "args":["-y","tavily-mcp"],"env":{"TAVILY_API_KEY":"..."}}
#
#   Brave search (needs BRAVE_API_KEY):
#     {"name":"brave","transport":"stdio","command":"npx",
#      "args":["-y","@modelcontextprotocol/server-brave-search"],
#      "env":{"BRAVE_API_KEY":"..."}}
#
# SWIFT_EVALUATOR_MCP_SERVERS=[]

# ─── Orchestrator ─────────────────────────────────────────
# Number of revision passes AFTER the initial draft before the
# orchestrator gives up. Total attempts per article =
# 1 + SWIFT_ORCHESTRATOR_MAX_RETRIES. Default is 3 per the scaffolding
# plan (so up to four attempts).
# SWIFT_ORCHESTRATOR_MAX_RETRIES=3

# ─── Image agent (Pollinations.ai) ────────────────────────
# The Image Agent builds Pollinations URLs; end users' browsers
# fetch them. Anonymous access works out of the box — these knobs
# tune image style, dimensions, and attribution.
#
# SWIFT_POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
# SWIFT_POLLINATIONS_MODEL=flux           # flux | flux-realism | turbo | sana
# SWIFT_POLLINATIONS_WIDTH=1024
# SWIFT_POLLINATIONS_HEIGHT=1024
# SWIFT_POLLINATIONS_ENHANCE=true         # server-side prompt rewrite, free
# SWIFT_POLLINATIONS_NOLOGO=false         # needs a Pollinations account
# SWIFT_POLLINATIONS_SEED=                # set an int for deterministic URLs
# SWIFT_POLLINATIONS_REFERRER=swift-writer # web-app-safe app identifier

# ─── MCP server (Step 6) ──────────────────────────────────
# Controls Swift as an MCP server — the surface external clients
# (Claude Desktop, Cursor, other agents) talk to.
# SWIFT_MCP_SERVER_ENABLED=true
# SWIFT_MCP_SERVER_MOUNT_PATH=/mcp
# SWIFT_MCP_SERVER_BEARER_TOKEN=              # REQUIRED for public deployments

# ─── SSE streaming endpoint (Step 7) ──────────────────────
# POST /api/generate/stream emits Server-Sent Events while the
# pipeline works. Browsers drop idle SSE connections after ~30s;
# Swift sends a keep-alive comment every N seconds to keep the
# channel warm during long Writer calls. Lower this if you're
# behind an aggressive proxy; raise it to reduce noise.
# SWIFT_SSE_KEEP_ALIVE_SECONDS=15

# ─── Next.js (Step 8) — in frontend/.env.local, not here ──
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
